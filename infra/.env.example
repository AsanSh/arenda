# Пример файла .env для docker-compose
# Скопируйте в .env и заполните значения

# Backend настройки
SECRET_KEY=your-secret-key-change-in-production
DEBUG=0
POSTGRES_DB=amt_db
POSTGRES_USER=amt_user
POSTGRES_PASSWORD=your-secure-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Frontend настройки
REACT_APP_API_URL=https://assetmanagement.team/api

# Feature flags (SaaS-модули, по умолчанию выключены)
# Backend — включить аналитику, кабинет инвестора, умный прогноз
FEATURE_ANALYTICS=false
FEATURE_INVESTOR_PORTAL=false
FEATURE_SMART_FORECAST=false

# Frontend (для npm run build) — должны совпадать с backend
REACT_APP_FEATURE_ANALYTICS=false
REACT_APP_FEATURE_INVESTOR_PORTAL=false
REACT_APP_FEATURE_SMART_FORECAST=false

# Green API настройки (для WhatsApp)
ID_INSTANCE=7107486710
API_TOKEN_INSTANCE=6633644896594f7db36235195f23579325e7a9498eab4411bd
